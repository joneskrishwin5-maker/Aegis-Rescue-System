<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E0E0">

    <!-- 1. MAIN UI SCREEN -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- FULL SCREEN MAP -->
        <WebView
            android:id="@+id/mapWebView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Floating Glass Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#F2FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <!-- Sidebar Menu Button -->
                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00000000"
                    android:text="☰"
                    android:textColor="#1A237E"
                    android:textSize="24sp"
                    android:padding="0dp"
                    android:stateListAnimator="@null"
                    app:cornerRadius="24dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AEGIS"
                        android:textColor="#000000"
                        android:letterSpacing="0.1"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNodeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡 0 Nodes Connected"
                        android:textColor="#0288D1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Profile Icon -->
                <androidx.cardview.widget.CardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#1A237E">
                    
                    <Button
                        android:id="@+id/btnProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="👤"
                        android:textSize="18sp"
                        android:padding="0dp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Floating GPS Status Pill -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/btnSosCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Acquiring GPS Lock..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- Massive Circular SOS Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnSosCard"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="#D32F2F"
            app:cardCornerRadius="70dp"
            app:cardElevation="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="SOS"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. SLIDING SIDEBAR (Unified Soft Light Theme) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Updated Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disaster Precaution"
            android:textColor="#1A237E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap for survival guidelines"
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginBottom="32dp"/>

        <!-- Curvy Unified Sidebar Buttons (No Emojis, Centered) -->
        <Button
            android:id="@+id/btnEarthquake"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Earthquake"
            android:gravity="center"
            android:textColor="#1A237E"
            android:backgroundTint="#E8EAF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="32dp" />

        <Button
            android:id="@+id/btnFlood"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Flood"
            android:gravity="center"
            android:textColor="#1A237E"
            android:backgroundTint="#E8EAF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="32dp" />

        <Button
            android:id="@+id/btnFire"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Wildfire"
            android:gravity="center"
            android:textColor="#1A237E"
            android:backgroundTint="#E8EAF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="32dp" />
            
        <Button
            android:id="@+id/btnCyclone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Cyclone"
            android:gravity="center"
            android:textColor="#1A237E"
            android:backgroundTint="#E8EAF6"
            android:textStyle="bold"
            android:textSize="15sp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="32dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>